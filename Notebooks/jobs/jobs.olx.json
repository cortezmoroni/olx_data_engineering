        quartz_cron_expression: 29 0 8 * * ?
        timezone_id: America/Sao_Paulo
        pause_status: UNPAUSED
      tasks:
        - task_key: bronze_ingestion
          notebook_task:
            notebook_path: /Workspace/Users/moronicortez@outlook.com/Drafts/Bronze_olx/bronze_olx
            source: WORKSPACE
        - task_key: gold_ingestion_metrics
          depends_on:
            - task_key: data_quality
          notebook_task:
            notebook_path: /Workspace/Users/moronicortez@outlook.com/Drafts/Gold_olx/gold_real_estate_metrics
            source: WORKSPACE
        - task_key: silver_ingestion
          depends_on:
            - task_key: bronze_ingestion
          notebook_task:
            notebook_path: /Workspace/Users/moronicortez@outlook.com/Drafts/Silver_olx/silver_real_estate_listings
            source: WORKSPACE
        - task_key: data_quality
          depends_on:
            - task_key: silver_ingestion
          notebook_task:
            notebook_path: /Workspace/Users/moronicortez@outlook.com/Drafts/data_quality/gold_real_estate_metrics_pandera
            source: WORKSPACE
      queue:
        enabled: true
      performance_target: PERFORMANCE_OPTIMIZED
